# Frontend API connection
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Database & CORS
DATABASE_URL=sqlite:///./portfolio.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Independent Background Price Monitoring Worker
# Supported providers: shoonya_ws | shoonya | yfinance | fixture
PRICE_PROVIDER=shoonya_ws
EXCHANGE_CALENDAR=nse_bse
ALERT_RULES_ENABLED=true
MARKET_HOURS_OVERRIDE=false
YFINANCE_CACHE_TTL_SECONDS=60
YFINANCE_STALE_AFTER_SECONDS=900

# Shoonya (Finvasia) NorenRestApiPy Live WebSocket & REST Credentials
SHOONYA_USER_ID=FA12345
SHOONYA_PASSWORD=replace_with_shoonya_password
SHOONYA_TOTP_SECRET=JBSWY3DPEHPK3PXP
SHOONYA_VENDOR_CODE=FA12345_U
SHOONYA_API_SECRET=replace_with_shoonya_app_key
SHOONYA_IMEI=abc1234
SHOONYA_HOST=https://api.shoonya.com/NorenWClientTP/
SHOONYA_WS_ENDPOINT=wss://api.shoonya.com/NorenWSTP/
SHOONYA_QUOTE_FRESHNESS_SECONDS=300
SHOONYA_RECONNECT_BASE_SECONDS=2.0
SHOONYA_RECONNECT_MAX_SECONDS=60.0
SHOONYA_MAX_RECONNECT_ATTEMPTS=0
# Optional JSON map for overriding or adding custom NSE/BSE token IDs:
# SHOONYA_TOKEN_MAP_JSON={"NSE:BHEL":"438","NSE:TEGA":"7529"}

# Notification Delivery Configuration
NOTIFICATION_DELIVERY_MODE=live
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=alerts@plutuswealth.com
SMTP_USE_TLS=true
# Optional local directory for spooling .eml files when testing without external SMTP
# SMTP_SPOOL_DIR=./email_spool
