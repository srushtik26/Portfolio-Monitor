# Frontend API connection
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Database & CORS
DATABASE_URL=sqlite:///./portfolio.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
PRIVATE_UPLOAD_DIR=./var/private_uploads
# Optional one-time bootstrap for the first administrator account (never commit real credentials):
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Independent Background Price Monitoring Worker
# Primary is Yahoo Finance (delayed candle data); Angel One REST is optional server-only backup.
PRICE_PROVIDER_PRIMARY=yfinance
PRICE_PROVIDER_BACKUP=angel_rest
EXCHANGE_CALENDAR=fixture
WORKER_INTERVAL_SECONDS=60
ALERT_RULES_ENABLED=false
# Set to always_open (or true) to bypass NSE/BSE 09:15-15:30 IST market hours check
MARKET_HOURS_OVERRIDE=false
YFINANCE_CACHE_TTL_SECONDS=60
YFINANCE_STALE_AFTER_SECONDS=300

# Optional Angel One SmartAPI REST Backup (Server-only, Quotes-only, Owner-only)
# Leave empty if not using Angel backup — yfinance primary continues working normally.
# Never place Angel credentials in SHOONYA_* variables.
ANGEL_OWNER_ENABLED=false
# ANGEL_OWNER_NAME=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# ANGEL_TOKEN_MAP_JSON={"NSE:BHEL":"438"}
SHOONYA_API_SECRET=placeholder_api_secret
SHOONYA_IMEI=placeholder_imei
# UNVERIFIED legacy endpoints (see README "Shoonya prerequisites before enabling"):
SHOONYA_HOST=https://api.shoonya.com/NorenWClientTP/
SHOONYA_WS_ENDPOINT=wss://api.shoonya.com/NorenWSTP/
SHOONYA_QUOTE_FRESHNESS_SECONDS=300
SHOONYA_TICK_QUEUE_MAXSIZE=256
SHOONYA_RECONNECT_BASE_SECONDS=2.0
SHOONYA_RECONNECT_MAX_SECONDS=60.0
SHOONYA_MAX_RECONNECT_ATTEMPTS=0
# Optional JSON map for overriding or adding custom NSE/BSE token IDs (UNVERIFIED until confirmed):
# SHOONYA_TOKEN_MAP_JSON={"NSE:BHEL":"438","NSE:TEGA":"7529"}

# Notification Delivery Configuration
# Single notification mode variable: dry_run (default) | live
# Live delivery requires BOTH NOTIFICATION_MODE=live AND complete SMTP settings below.

NOTIFICATION_MODE=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ALERT_EMAIL_RECIPIENTS=
# Optional local directory for spooling .eml files in local dry-run/spool testing:
# SMTP_SPOOL_DIR=./email_spool
