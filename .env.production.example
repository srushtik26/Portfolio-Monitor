# ==============================================================================
# Northstar Portfolio Monitor — Production Environment Template (Oracle Free VM)
# Copy to .env on the server and replace all placeholders with real secrets.
# NEVER commit .env with real passwords to Git.
# ==============================================================================

# Domain pointed to your Oracle Cloud VM public IP (Caddy auto-provisions Let's Encrypt HTTPS)
DOMAIN=monitor.example.com
APP_ENV=production
CORS_ORIGINS=https://monitor.example.com

# PostgreSQL (Docker internal network only; NOT exposed publicly)
POSTGRES_DB=portfolio_monitor
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_DB_PASSWORD

# Authentication & Session Security
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=true
# Optional one-time initial admin bootstrap (remove after first boot or run: docker compose exec api python -m app.bootstrap_admin)
# BOOTSTRAP_ADMIN_NAME=Srushti Kadam
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS_COMPLEX

# Independent Background Market-Data Worker
# Primary is Yahoo Finance (delayed candle data); Angel One REST is optional server-only backup.
PRICE_PROVIDER_PRIMARY=yfinance
PRICE_PROVIDER_BACKUP=angel_rest
EXCHANGE_CALENDAR=nse_bse
WORKER_INTERVAL_SECONDS=60
ALERT_RULES_ENABLED=true
# Set to always_open (or true) to bypass NSE/BSE 09:15-15:30 IST market hours check
MARKET_HOURS_OVERRIDE=false
YFINANCE_CACHE_TTL_SECONDS=60
YFINANCE_STALE_AFTER_SECONDS=300

# Optional Angel One SmartAPI REST Backup (Server-only, Quotes-only, Owner-only)
# Leave empty if not using Angel backup — yfinance primary continues working normally.
ANGEL_OWNER_ENABLED=false
# ANGEL_OWNER_NAME=
ANGEL_API_KEY=Y4rcOmzr
ANGEL_CLIENT_CODE=AACN790590
ANGEL_PIN=2604
ANGEL_TOTP_SECRET=PCAM2NUHVNU56EGFUUB3K7DIBY

# Notification Delivery Safety Gate
# Defaults to dry_run. Live email delivery requires BOTH NOTIFICATION_MODE=live AND complete SMTP settings.
NOTIFICATION_MODE=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# ALERT_EMAIL_RECIPIENTS=alerts@example.com
